{
	# IP clients omit SNI; the container's local address is not the public IP.
	default_sni {$KEKBOT_PUBLIC_IP}
}

https://{$KEKBOT_PUBLIC_IP} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	@provider path /api/providers/*
	@application not path /api/providers/*
	request_body @provider {
		max_size 64KB
	}
	request_body @application {
		max_size 12MiB
	}
	reverse_proxy kekbot:3000 {
		flush_interval -1
	}
}
