# Copy to .env.local. Live mode is the default; missing credentials never select fixtures.
KEKBOT_MODE=live
KEKBOT_DATA_DIR=./data
KEKBOT_RUN_JOBS=1
NEXT_TELEMETRY_DISABLED=1
HOSTNAME=127.0.0.1
PORT=3000

# Public HTTPS origin; register the exact callback and webhook paths from docs/FOUNDATION.md.
KEKBOT_PUBLIC_URL=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_BROADCASTER_USER_ID=
# Official delivery identity. A custom bot identity is not assumed.
KICK_CHAT_TYPE=bot

# init creates separate key and proof-token files under data/<mode>/secrets/.
# Mount these separately in production. Never commit them or include them in exports.
# KEKBOT_ENCRYPTION_KEY_FILE=/run/secrets/kekbot-key
# KEKBOT_PROOF_TOKEN_FILE=/run/secrets/kekbot-proof-token
# KICK_CLIENT_SECRET_FILE=/run/secrets/kick-client-secret
